# =============================================================================
# Eventease - Environment Variables Template
# Salin file ini menjadi `.env` lalu sesuaikan isinya: `cp .env.example .env`
# =============================================================================

# Server Port Expose (Nginx Reverse Proxy)
PORT=80

# Database Configuration (MySQL 8.0)
DB_PORT=3306
DB_NAME=eventease_db
DB_USER=eventease_user
DB_PASSWORD=supersecret_db_password
DB_ROOT_PASSWORD=supersecret_root_password

# Redis Configuration (Caching & Token Blacklist)
REDIS_PORT=6379

# RabbitMQ Configuration (Async Queue & Background Workers)
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USERNAME=eventease_rabbit
RABBITMQ_PASSWORD=supersecret_rabbit_password

# JWT Security (Generate with: openssl rand -hex 64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Payment Gateway (Midtrans Snap)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# SMTP Mail Server (Gmail / SendGrid)
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password

# Cloudinary Storage (Optional - for Banner Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
