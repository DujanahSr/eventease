# ===================================================================
# Template for application-secret.properties (Local Development)
# Copy this file to application-secret.properties and fill in your values.
# NOTE: application-secret.properties is gitignored and will NOT be committed.
# ===================================================================

# Midtrans Payment Gateway (Sandbox Keys)
midtrans.server.key=your-midtrans-server-key
midtrans.client.key=your-midtrans-client-key

# Gmail App Password (16 characters from Google Account -> Security -> App Passwords)
spring.mail.password=your-gmail-app-password

# Cloudinary CDN Credentials
cloudinary.cloud_name=your-cloudinary-cloud-name
cloudinary.api_key=your-cloudinary-api-key
cloudinary.api_secret=your-cloudinary-api-secret

# Local PostgreSQL Database Password
spring.datasource.password=your-local-db-password
