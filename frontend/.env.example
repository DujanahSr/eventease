# ===================================================================
# Eventease Frontend Environment Variables (Template)
# Duplicate to .env.local for local overrides
# ===================================================================

# REST API Base URL (leave /api for same-origin proxy or set full URL e.g. https://api.yourdomain.com/api)
VITE_API_BASE_URL=/api

# WebSocket STOMP Endpoint (leave /ws for same-origin proxy or set full URL e.g. https://api.yourdomain.com/ws)
VITE_WS_URL=/ws
